{%- comment -%}
  Photo wall — quantity is the message.

  Sixteen small frames of people beat one hero shot here. No captions, no
  headings on the images: the point is not any individual photograph, it is the
  accumulated evidence that a lot of people showed up a lot of times.

  Deliberately full-bleed and gapless-tight so it reads as one dense field
  rather than a gallery of separate pictures.
{%- endcomment -%}

{{ 'club.css' | asset_url | stylesheet_tag }}

<div class="club-wall color-{{ section.settings.color_scheme }} gradient">
  {%- liquid
    assign justified = false
    if section.settings.layout == 'justified'
      assign justified = true
      assign row_cqw = section.settings.row_height | times: 100.0 | divided_by: 1280
      assign row_cqw_mobile = section.settings.row_height_mobile | times: 100.0 | divided_by: 390
      assign sizes_vw = row_cqw | times: 1.2
      assign sizes_vw_mobile = row_cqw_mobile | times: 1.3
    endif
  -%}
  {%- if justified -%}<div class="club-wall__inner">{%- endif -%}
  {%- if section.settings.heading != blank -%}
    {%- if justified -%}
      <h2 class="club-wall__title">{{ section.settings.heading }}</h2>
    {%- else -%}
      <div class="page-width">
        <h2 class="club-wall__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
  {%- endif -%}
  <div
    class="club-wall__grid{% if justified %} club-wall__grid--justified{% endif %}"
    style="--wall-columns: {{ section.settings.columns }}; --wall-gap: {{ section.settings.gap }}px;
    {%- if justified %} --wall-row-desktop: {{ row_cqw | round: 3 }}cqw; --wall-row-mobile: {{ row_cqw_mobile | round: 3 }}cqw;{% endif %}"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign cell_shape = ''
        assign cell_sizes = '(min-width: 990px) 25vw, 50vw'
        assign cell_widths = '300, 500, 700, 1000, 1200'
        assign ratio = block.settings.image.aspect_ratio
        if justified
          if ratio == blank
            assign ratio = 1.333
          endif
          assign cell_sizes = ratio | times: sizes_vw | round | append: 'vw'
          assign cell_sizes_mobile = ratio | times: sizes_vw_mobile | at_most: 100 | round | append: 'vw'
          assign cell_sizes = '(min-width: 750px) ' | append: cell_sizes | append: ', ' | append: cell_sizes_mobile
          assign cell_widths = '300, 450, 600, 800, 1000, 1200, 1600, 2000, 2400'
        elsif ratio != blank
          if ratio < 0.9
            assign cell_shape = ' club-wall__cell--tall'
          elsif ratio > 1.9
            assign cell_shape = ' club-wall__cell--wide'
          endif
        endif
      -%}
      <div
        class="club-wall__cell{{ cell_shape }}"
        {% if justified %}
          style="--ratio: {{ ratio }};"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 2400
            | image_tag: loading: 'lazy', sizes: cell_sizes, widths: cell_widths, class: 'club-wall__img'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg club-wall__img' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- if justified -%}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "Club photo wall",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Dense wall of past seasons' photos. Aim for 12–25 images — below about 12 the wall reads as a sparse gallery instead of a crowd. Mosaic crops photos into tiles (portraits tall, panoramas wide); justified rows keep every photo whole."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "mosaic", "label": "Mosaic" },
        { "value": "justified", "label": "Justified rows (no cropping)" }
      ],
      "default": "mosaic"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop, mosaic)",
      "default": 4
    },
    {
      "type": "range",
      "id": "row_height",
      "min": 180,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Row height on a 1280px screen (justified)",
      "info": "Scales with screen width. Rows stretch a little to fill the width.",
      "default": 270
    },
    {
      "type": "range",
      "id": "row_height_mobile",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Row height on a 390px phone (justified)",
      "default": 120
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Gap",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "In the mosaic, portrait photos take a tall tile and panoramas a wide one, automatically."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Club photo wall",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
