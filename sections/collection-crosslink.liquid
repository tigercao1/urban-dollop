{%- comment -%}
  Cross-link card under a collection's product grid, e.g. 少儿团课 -> 小型私课.
  Each block is one card and names the collection it shows on ("Show on"),
  so one section in a shared template (collection.json) can hold the cards for
  several collections; only the blocks for the current collection render.
{%- endcomment -%}
{%- liquid
  assign has_card = false
  for block in section.blocks
    if block.settings.show_on != blank and block.settings.show_on.handle == collection.handle
      assign has_card = true
    endif
  endfor
-%}
{%- if has_card -%}
  {{ 'component-collection-crosslink.css' | asset_url | stylesheet_tag }}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
  <div class="page-width section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- if block.settings.show_on != blank and block.settings.show_on.handle == collection.handle -%}
        <div class="collection-crosslink" {{ block.shopify_attributes }}>
          <div class="collection-crosslink__body">
            {%- if block.settings.eyebrow != blank -%}
              <p class="collection-crosslink__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="collection-crosslink__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="collection-crosslink__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
            <a class="collection-crosslink__button button button--primary" href="{{ block.settings.button_link }}">
              <span>{{ block.settings.button_label | escape }}</span>
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection cross-link",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Cross-link card",
      "settings": [
        {
          "type": "collection",
          "id": "show_on",
          "label": "Show on collection"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small label",
          "default": "也可以看看"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection cross-link"
    }
  ]
}
{% endschema %}
