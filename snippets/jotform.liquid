{%- comment -%}
  Waiver link. The form itself stays hosted at JotForm — only the styling is
  brought in-theme. Presentation lives in .waiver-link (alpine-storefront.css).
{%- endcomment -%}
{% if shop.locale == 'en' %}
  <a
    href="
      javascript:void(
        window.open(
          'https://form.jotform.com/232628492941059',
          'blank',
          'scrollbars=yes,
          toolbar=no,
          width=700,
          height=500'
        )
      )
    "
    target="_blank"
    class="waiver-link"
  >
    {{ "custom_liquid.product.waiver" | t }}
  </a>
{% else %}
  <a
    href="
      javascript:void(
        window.open(
          'https://form.jotform.com/242658653833264',
          'blank',
          'scrollbars=yes,
          toolbar=no,
          width=700,
          height=500'
        )
      )
    "
    target="_blank"
    class="waiver-link"
  >
    {{ "custom_liquid.product.waiver" | t }}
  </a>
{% endif %}
