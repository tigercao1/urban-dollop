{%- comment -%}
  Club hero — full-bleed, 100vh, video-first.

  Dawn's image-banner is page-width-capped and text-forward. This is the
  opposite: footage fills the viewport, type sits on top, nothing is centred in
  a box. If no video is set it degrades to a still image, so the section is
  safe to place before the footage exists.

  The "next up" strip at the bottom is the club signal — a visitor should see a
  real date and a real spot count inside one screen, before any scrolling.
{%- endcomment -%}

{{ 'club.css' | asset_url | stylesheet_tag }}

<div
  class="club-hero{% if section.settings.show_scrim %} club-hero--scrim{% endif %}"
  style="--hero-height: {{ section.settings.height }}vh;"
>
  <div class="club-hero__media">
    {%- if section.settings.video != blank -%}
      {%- liquid
        if section.settings.image != blank
          assign hero_poster = section.settings.image | image_url: width: 1280
        else
          assign hero_poster = section.settings.video.preview_image | image_url: width: 1280
        endif

        comment
          Pick one MP4 rendition per screen size instead of always loading the
          1080p file (about 19 MB). Phones get ~480p, tablets ~720p, desktop 1080p.
        endcomment
        assign hero_sd = blank
        assign hero_hd = blank
        assign hero_fhd = blank
        for source in section.settings.video.sources
          if source.format == 'mp4'
            if source.height <= 540
              assign hero_sd = source.url
            elsif source.height <= 800
              assign hero_hd = source.url
            elsif source.height <= 1080
              assign hero_fhd = source.url
            endif
          endif
        endfor
        if hero_fhd == blank
          assign hero_fhd = hero_hd
        endif
        if hero_fhd == blank
          assign hero_fhd = hero_sd
        endif
        if hero_hd == blank
          assign hero_hd = hero_fhd
        endif
        if hero_sd == blank
          assign hero_sd = hero_hd
        endif
        comment
          The storefront only lists the 1080p MP4 in video.sources, but Shopify
          also stores 480p and 720p files next to it with the standard names.
          Derive them from the 1080p URL. If a file is missing, the browser
          falls through to the last <source> (1080p).
        endcomment
        if hero_hd == hero_fhd and hero_fhd contains 'HD-1080p-7.2Mbps'
          assign hero_hd = hero_fhd | replace: 'HD-1080p-7.2Mbps', 'HD-720p-4.5Mbps'
        endif
        if hero_sd == hero_fhd and hero_fhd contains 'HD-1080p-7.2Mbps'
          assign hero_sd = hero_fhd | replace: 'HD-1080p-7.2Mbps', 'SD-480p-1.5Mbps'
        endif
      -%}
      {%- if hero_fhd != blank -%}
        <video
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          {% if hero_poster != blank %}poster="{{ hero_poster }}"{% endif %}
        >
          <source src="{{ hero_sd }}" type="video/mp4" media="(max-width: 749px)">
          <source src="{{ hero_hd }}" type="video/mp4" media="(max-width: 1199px)">
          <source src="{{ hero_fhd }}" type="video/mp4">
        </video>
      {%- else -%}
        {{
          section.settings.video
          | video_tag:
            poster: hero_poster,
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true
        }}
      {%- endif -%}
      {%- if hero_poster != blank -%}
        <img class="club-hero__still" src="{{ hero_poster }}" alt="" width="1280" height="720" loading="lazy">
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
          class: 'club-hero__img'
      }}
    {%- else -%}
      <div class="club-hero__placeholder">
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="club-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="club-hero__eyebrow">
        <span class="club-hero__eyebrow-part">
          {{- section.settings.eyebrow | split: ' · ' | join: '</span>&nbsp;· <span class="club-hero__eyebrow-part">' -}}
        </span>
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="club-hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="club-hero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.slogan != blank -%}
      <p class="club-hero__slogan">{{ section.settings.slogan }}</p>
    {%- endif -%}

    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="club-hero__actions">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: '#' }}" class="button club-hero__cta">
            {{- section.settings.button_label_1 -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a
            href="{{ section.settings.button_link_2 | default: '#' }}"
            class="button button--secondary club-hero__cta"
          >
            {{- section.settings.button_label_2 -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.help_label != blank -%}
      <a href="{{ section.settings.help_link | default: '#lesson-picker' }}" class="club-hero__help">
        {{- section.settings.help_label -}}
      </a>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="club-hero__nextup">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="club-hero__nextup-item"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.date != blank -%}
            <span class="club-hero__nextup-date">{{ block.settings.date }}</span>
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <span class="club-hero__nextup-label">{{ block.settings.label }}</span>
          {%- endif -%}
          {%- if block.settings.meta != blank -%}
            <span class="club-hero__nextup-meta">{{ block.settings.meta }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Club hero",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Full-bleed hero. Add a looping video for the strongest effect; an image is used as fallback when no video is set."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (looping, muted)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image"
    },
    {
      "type": "range",
      "id": "height",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Height",
      "default": 90
    },
    {
      "type": "checkbox",
      "id": "show_scrim",
      "label": "Darken media for text legibility",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Mt St Louis Moonstone"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "S SNOW"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "多伦多滑雪俱乐部"
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "Slogan"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "26/27 报名开始"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "成为会员"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "help_label",
      "label": "Text link under the buttons",
      "info": "e.g. 不知道选哪个课？30 秒帮你选 → Leave empty to hide."
    },
    {
      "type": "text",
      "id": "help_link",
      "label": "Text link target",
      "info": "#lesson-picker jumps to the lesson picker section on this page; a page path like /pages/... also works.",
      "default": "#lesson-picker"
    }
  ],
  "blocks": [
    {
      "type": "nextup",
      "name": "Next up",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "1月18日"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "周末团课"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta",
          "default": "余 6 位"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Club hero",
      "blocks": [{ "type": "nextup" }]
    }
  ]
}
{% endschema %}
