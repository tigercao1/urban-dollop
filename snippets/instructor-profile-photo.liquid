{%- if photo != blank -%}
  {%- assign ratio = photo.aspect_ratio | default: photo.preview_image.aspect_ratio | default: 1 -%}
  <li class="instructor-profile__photo" style="--photo-ratio: {{ ratio }};">
    {{
      photo
      | image_url: width: 1600
      | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1600', alt: alt
    }}
  </li>
{%- endif -%}
