{%- comment -%}
  Roster body shared by every source. Accepts: roster (the paginated .values
  array, read inside the paginate block), all_entries, paginate, section, and
  optionally legacy (our_team .values). Legacy entries whose handle also exists
  in roster are skipped, so a published SSMS instructor replaces their legacy
  card.
{%- endcomment -%}

{%- capture roster_handles -%}
  |{%- for entry in roster -%}{{ entry.system.handle }}|{%- endfor -%}
{%- endcapture -%}

{%- assign legacy_shown = 0 -%}
{%- capture order_keys -%}
  {%- for entry in roster -%}
    {%- assign position = entry.sort_order.value | default: 999999 | plus: 1000000 -%}
    {{- position -}}-a-{{- forloop.index0 | plus: 10000 -}},
  {%- endfor -%}
  {%- for entry in legacy -%}
    {%- assign handle_key = '|' | append: entry.system.handle | append: '|' -%}
    {%- unless roster_handles contains handle_key -%}
      {%- assign legacy_shown = legacy_shown | plus: 1 -%}
      {%- assign position = entry.sort_order.value | default: 999999 | plus: 1000000 -%}
      {{- position -}}-b-{{- forloop.index0 | plus: 10000 -}},
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign order_keys = order_keys | split: ',' | sort -%}

{%- if request.design_mode -%}
  <p class="club-roster__count">
    {%- if legacy != blank -%}
      {{ roster.size }} published SSMS instructors, plus {{ legacy_shown }} of {{ legacy.size }} legacy instructors who have no published SSMS entry.
    {%- else -%}
      Showing {{ roster.size }} of {{ all_entries.size }} entries.
    {%- endif %}
    (Editor only — visitors do not see this.)
  </p>
  {%- if legacy.size >= 50 -%}
    <p class="club-roster__empty">
      WARNING: the legacy list has 50 or more entries, and only the first 50 can be read here.
    </p>
  {%- endif -%}
  {%- if section.settings.enable_filter and paginate.pages > 1 -%}
    <p class="club-roster__empty">
      WARNING: the roster is split across {{ paginate.pages }} pages, but
      filtering is client-side — it can only filter the cards on the
      current page while appearing to search everything. Raise “Entries
      per page”, or turn filtering off until this becomes a server-side
      filter.
    </p>
  {%- endif -%}
{%- endif -%}

{%- liquid
  assign search_label = 'sections.instructors.search_label' | t
  assign facet_fields = 'certification,type,client_groups,locations,languages' | split: ','
  assign place_groups = 'locations,client_groups' | split: ','
  assign language_groups = 'languages' | split: ','
  assign sheet_title_id = 'InstructorSheetTitle-' | append: section.id

  assign show_discipline = false
  if section.settings.filter_type or section.settings.filter_certification
    assign show_discipline = true
  endif

  assign show_sheet = false
  if show_discipline or section.settings.filter_client_groups or section.settings.filter_locations or section.settings.filter_languages or section.settings.filter_min_age
    assign show_sheet = true
  endif
-%}

{%- capture value_labels -%}
  {"ski":{{ 'sections.instructors.values.ski' | t | json }},"snowboard":{{ 'sections.instructors.values.snowboard' | t | json }}}
{%- endcapture -%}

{%- capture level_labels -%}
  {"template":{{ 'sections.instructors.level_option' | t: level: '[level]' | json }},"park":{{ 'sections.instructors.level_park' | t | json }},"carving":{{ 'sections.instructors.level_carving' | t | json }}}
{%- endcapture -%}

{%- capture alternate_roots -%}
  {%- for language in localization.available_languages -%}
    {%- unless language.iso_code == request.locale.iso_code -%}{{ language.root_url }} {% endunless -%}
  {%- endfor -%}
{%- endcapture -%}

<instructor-filter
  data-value-labels="{{ value_labels | escape }}"
  data-level-labels="{{ level_labels | escape }}"
  data-card-meta-field="{{ section.settings.meta_field }}"
  data-section-id="{{ section.id }}"
  data-alternate-roots="{{ alternate_roots | strip | escape }}"
  data-pinyin-src="{{ 'pinyin-pro.min.js' | asset_url }}"
>
  {%- if section.settings.enable_filter -%}
    {%- comment -%}
      no-js-hidden: with JS off the controls never appear and the full
      roster renders. A visible control that does nothing is worse than
      no control.
    {%- endcomment -%}
    <div class="club-filter no-js-hidden" role="search" aria-label="{{ search_label | escape }}">
      {%- if section.settings.filter_by_name -%}
        <div class="club-filter__search field">
          <input
            id="InstructorSearch-{{ section.id }}"
            type="search"
            class="club-filter__input field__input"
            placeholder="{{ search_label | escape }}"
            autocomplete="off"
            enterkeyhint="search"
            data-instructor-search
          >
          <label class="field__label" for="InstructorSearch-{{ section.id }}">
            {{- search_label -}}
          </label>
          <span class="club-filter__search-icon field__button" aria-hidden="true">
            <svg class="icon icon-search" viewBox="0 0 18 19" fill="none" focusable="false">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.7l5.4 5.4a.5.5 0 11-.71.7l-5.41-5.4z" fill="currentColor"/>
            </svg>
          </span>
        </div>
      {%- endif -%}

      <div class="club-filter__status">
        {%- if show_sheet -%}
          <button
            type="button"
            class="club-filter__open button button--secondary"
            aria-haspopup="dialog"
            data-filter-open
            data-active-template="{{ 'sections.instructors.filters_count' | t: active: '[active]' | escape }}"
          >
            {%- render 'icon-filter' -%}
            <span data-filter-open-label>{{ 'sections.instructors.filters' | t }}</span>
          </button>
        {%- endif -%}
        <button type="button" class="club-filter__clear link" hidden data-instructor-clear>
          {{- 'sections.instructors.clear' | t -}}
        </button>
        <p
          class="club-filter__count"
          role="status"
          aria-live="polite"
          data-instructor-count
          data-template="{{ 'sections.instructors.count' | t: shown: '[shown]', total: '[total]' | escape }}"
        ></p>
      </div>
    </div>

    {%- if show_sheet -%}
      <dialog class="club-sheet" aria-modal="true" aria-labelledby="{{ sheet_title_id }}" data-filter-sheet>
        <div class="club-sheet__panel">
          <div class="club-sheet__head">
            <h2 class="club-sheet__title" id="{{ sheet_title_id }}">{{ 'sections.instructors.filters' | t }}</h2>
            <button
              type="button"
              class="club-sheet__close"
              aria-label="{{ 'sections.instructors.close' | t | escape }}"
              data-filter-close
            >
              {%- render 'icon-close' -%}
            </button>
          </div>

          <div class="club-sheet__body">
            {%- if show_discipline -%}
              <fieldset class="club-filter__group" hidden data-discipline-group>
                <legend class="club-filter__legend">{{ 'sections.instructors.facets.type' | t }}</legend>
                <div class="club-segment">
                  <button type="button" class="club-segment__option" aria-pressed="false" data-discipline="ski">
                    {{- 'sections.instructors.values.ski' | t -}}
                  </button>
                  <button type="button" class="club-segment__option" aria-pressed="false" data-discipline="snowboard">
                    {{- 'sections.instructors.values.snowboard' | t -}}
                  </button>
                </div>
              </fieldset>
            {%- endif -%}

            {%- if section.settings.filter_certification -%}
              <fieldset class="club-filter__group" hidden data-level-group>
                <legend class="club-filter__legend">
                  {{- 'sections.instructors.facets.certification' | t }} <span data-level-org></span>
                </legend>
                <p class="club-filter__hint" data-level-hint>{{ 'sections.instructors.level_hint' | t }}</p>
                <div class="club-filter__chips" hidden data-level-chips></div>
              </fieldset>

              <label class="club-switch" hidden data-trainer-row>
                <span class="club-switch__label">{{ 'sections.instructors.trainer_only' | t }}</span>
                <input type="checkbox" role="switch" class="club-switch__input" data-trainer-switch>
              </label>
            {%- endif -%}

            {%- for field in place_groups -%}
              {%- assign setting_id = 'filter_' | append: field -%}
              {%- if section.settings[setting_id] -%}
                {%- render 'club-filter-group', field: field -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if section.settings.filter_min_age -%}
              <div class="club-filter__age field select" hidden data-age-filter>
                <select
                  id="InstructorAge-{{ section.id }}"
                  class="select__select field__input"
                  data-any-label="{{ 'sections.instructors.age_any' | t | escape }}"
                  data-option-template="{{ 'sections.instructors.age_option' | t: age: '[age]' | escape }}"
                ></select>
                <label class="field__label" for="InstructorAge-{{ section.id }}">
                  {{- 'sections.instructors.facets.age' | t -}}
                </label>
                {% render 'icon-caret' %}
              </div>
            {%- endif -%}

            {%- for field in language_groups -%}
              {%- assign setting_id = 'filter_' | append: field -%}
              {%- if section.settings[setting_id] -%}
                {%- render 'club-filter-group', field: field -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="club-sheet__foot">
            <button type="button" class="club-sheet__reset button button--secondary" data-filter-reset>
              {{- 'sections.instructors.reset' | t -}}
            </button>
            <button
              type="button"
              class="club-sheet__show button"
              data-filter-show
              data-template="{{ 'sections.instructors.show_results' | t: shown: '[shown]' | escape }}"
            ></button>
          </div>
        </div>
      </dialog>
    {%- endif -%}

    <p class="club-roster__empty" hidden data-instructor-empty>
      {{ 'sections.instructors.no_results' | t }}
    </p>
  {%- endif -%}

<ul
  class="club-roster__grid list-unstyled"
  style="--roster-columns: {{ section.settings.columns }};"
  role="list"
>
  {%- for order_key in order_keys -%}
    {%- liquid
      assign key_parts = order_key | split: '-'
      assign entry_index = key_parts[2] | minus: 10000
      if key_parts[1] == 'b'
        for candidate in legacy limit: 1 offset: entry_index
          assign entry = candidate
        endfor
      else
        for candidate in roster limit: 1 offset: entry_index
          assign entry = candidate
        endfor
      endif
    -%}
    {%- liquid
      # Never write a percent-brace sequence inside this tag body,
      # not even in a comment line. The tokenizer closes the tag at
      # the first closing delimiter it sees and dumps the remainder
      # to the page as literal text.
      if section.settings.link_target == 'collection'
        assign url = entry.collection_url.value
      else
        assign url = entry.system.url
      endif

      assign bio = blank
      if section.settings.show_bio
        assign bio = entry.introduction.value
      endif
    -%}

    {%- capture cert -%}
      {%- render 'club-instructor-field', entry: entry, field: 'certification' -%}
    {%- endcapture -%}
    {%- capture loc -%}
      {%- render 'club-instructor-field', entry: entry, field: section.settings.meta_field -%}
    {%- endcapture -%}
    {%- capture card_data -%}
      data-instructor-card
      data-handle="{{ entry.system.handle | escape }}"
      data-name="{{ entry.name.value | escape }}"
      data-min-age="{{ entry.min_age.value }}"
      {%- for field in facet_fields -%}
        {%- capture cell -%}
          {%- render 'club-instructor-field', entry: entry, field: field -%}
        {%- endcapture %}
      data-facet-{{ field | replace: '_', '-' }}="{{ cell | escape }}"
      {%- endfor -%}
    {%- endcapture -%}

    {%- render 'club-instructor-card',
      card_name: entry.name.value,
      card_cert: cert,
      card_loc: loc,
      card_bio: bio,
      card_image: entry.picture.value,
      card_url: url,
      card_class: 'club-roster__item',
      card_sizes: '(min-width: 990px) 20vw, 44vw',
      card_data: card_data
    -%}
  {%- endfor -%}
</ul>
</instructor-filter>
