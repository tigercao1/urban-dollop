    "@context": "https://schema.org",
    "@type": "SportsOrganization",
    "@id": {{ request.origin | append: '/#organization' | json }},
    "name": {{ shop.name | json }},
    "alternateName": "SSnow",
    "url": {{ request.origin | json }},
    {%- if settings.logo != blank %}
      "logo": {{ org_logo | json }},
    {%- endif %}
    "sport": ["Skiing", "Snowboarding"],
    "email": "info@ssnow.club",
    "telephone": "+1-647-806-9895",
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "telephone": "+1-647-806-9895",
        "email": "info@ssnow.club",
        "availableLanguage": ["Chinese", "English"]
      },
      {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "name": "WeChat",
        "description": "WeChat ID: ssnowclub",
        "availableLanguage": ["Chinese", "English"]
      }
    ],
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "Greater Toronto Area"
    },
    "location": [
      {
        "@type": "SkiResort",
        "name": "Mount St. Louis Moonstone",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "24 Mount St. Louis Road West",
          "addressLocality": "Coldwater",
          "addressRegion": "ON",
          "addressCountry": "CA"
        }
      },
      {
        "@type": "SkiResort",
        "name": "Blue Mountain Resort",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "190 Gord Canning Drive",
          "addressLocality": "The Blue Mountains",
          "addressRegion": "ON",
          "postalCode": "L9Y 1C2",
          "addressCountry": "CA"
        }
      }
    ],
    "sameAs": [
      "https://www.instagram.com/s_snow_club/",
      "https://www.xiaohongshu.com/user/profile/5f28c8c90000000001008ce3"
    ]
  }
</script>

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ home_url | json }},
      "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- liquid
  assign crumb_home = 'Home'
  if request.locale.iso_code contains 'zh'
    assign crumb_home = '首页'
  endif

  assign crumb_mid_name = blank
  assign crumb_mid_url = blank
  assign crumb_name = blank
  assign crumb_url = request.origin | append: request.path

  case request.page_type
    when 'product'
      assign crumb_name = product.title
      # Use the collection in the URL if there is one, else the product's first collection (skipping join-us).
      assign crumb_collection = collection
      assign crumb_handle = crumb_collection.handle | default: ''
      if crumb_handle == ''
        for c in product.collections
          if c.handle != 'join-us'
            assign crumb_collection = c
            assign crumb_handle = c.handle
            break
          endif
        endfor
      endif
      if crumb_handle != ''
        assign crumb_mid_name = crumb_collection.title
        assign crumb_mid_url = request.origin | append: crumb_collection.url
      endif
      assign crumb_url = request.origin | append: product.url
    when 'collection'
      assign crumb_name = collection.title
      assign crumb_url = request.origin | append: collection.url
    when 'page'
      assign crumb_name = page.title
      assign crumb_url = request.origin | append: page.url
    when 'metaobject'
      assign crumb_name = metaobject.name.value | default: page_title
      assign team_page = pages['our-team']
      if team_page != blank
        assign crumb_mid_name = team_page.title
        assign crumb_mid_url = request.origin | append: team_page.url
      endif
  endcase
-%}

{%- if crumb_name != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ crumb_home | json }},
          "item": {{ home_url | json }}
        },
        {%- if crumb_mid_name != blank %}
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ crumb_mid_name | strip_html | json }},
            "item": {{ crumb_mid_url | json }}
          },
        {%- endif %}
        {
          "@type": "ListItem",
          "position": {% if crumb_mid_name != blank %}3{% else %}2{% endif %},
          "name": {{ crumb_name | strip_html | json }},
          "item": {{ crumb_url | json }}
        }
      ]
    }
  </script>
{%- endif -%}
