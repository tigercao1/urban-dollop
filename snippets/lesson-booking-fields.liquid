{% comment %}
  Private-lesson booking details, replacing the Infinite Options app fields.

  The inputs sit above the Add to cart button and belong to the product form through
  the `form` attribute, so their values are added to the cart line as line item
  properties and show on the order (Shopify admin > Orders > line item).

  Property names follow the app's (联系电话, 学生姓名, 学生年龄, 学生水平描述) so old
  and new orders read the same. The old 微信号 field is now 微信/WhatsApp/邮箱, since
  customers can leave any of the three. The visible labels are translated.

  Usage: {% render 'lesson-booking-fields', product_form_id: product_form_id, block: block %}
{% endcomment %}
{{ 'component-lesson-fields.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign uid = block.id | default: 'lesson'
  assign required_mark = '<span class="lesson-fields__req" aria-hidden="true">*</span>'
-%}
<fieldset class="lesson-fields" {{ block.shopify_attributes }}>
  <legend class="lesson-fields__title">{{ 'products.lesson_fields.title' | t }}</legend>
  <p class="lesson-fields__hint">{{ 'products.lesson_fields.hint' | t }}</p>

  <div class="lesson-fields__grid">
    <div class="field">
      <input
        class="field__input"
        type="text"
        id="LessonStudent-{{ uid }}"
        name="properties[学生姓名]"
        form="{{ product_form_id }}"
        placeholder="{{ 'products.lesson_fields.student_name' | t }}"
        autocomplete="off"
        required
      >
      <label class="field__label" for="LessonStudent-{{ uid }}">
        {{- 'products.lesson_fields.student_name' | t }} {{ required_mark -}}
      </label>
    </div>

    <div class="field">
      <input
        class="field__input"
        type="number"
        inputmode="numeric"
        min="3"
        max="99"
        id="LessonAge-{{ uid }}"
        name="properties[学生年龄]"
        form="{{ product_form_id }}"
        placeholder="{{ 'products.lesson_fields.student_age' | t }}"
        required
      >
      <label class="field__label" for="LessonAge-{{ uid }}">
        {{- 'products.lesson_fields.student_age' | t }} {{ required_mark -}}
      </label>
    </div>

    <div class="field">
      <input
        class="field__input"
        type="tel"
        id="LessonPhone-{{ uid }}"
        name="properties[联系电话]"
        form="{{ product_form_id }}"
        placeholder="{{ 'products.lesson_fields.phone' | t }}"
        autocomplete="tel"
        required
      >
      <label class="field__label" for="LessonPhone-{{ uid }}">
        {{- 'products.lesson_fields.phone' | t }} {{ required_mark -}}
      </label>
    </div>

    <div class="lesson-fields__item">
    <div class="field">
      <input
        class="field__input"
        type="text"
        id="LessonWechat-{{ uid }}"
        name="properties[微信/WhatsApp/邮箱]"
        form="{{ product_form_id }}"
        placeholder="{{ 'products.lesson_fields.wechat' | t }}"
        autocomplete="off"
        aria-describedby="LessonWechatHint-{{ uid }}"
      >
      <label class="field__label" for="LessonWechat-{{ uid }}">{{ 'products.lesson_fields.wechat' | t }}</label>
    </div>
    <small class="lesson-fields__note" id="LessonWechatHint-{{ uid }}">{{ 'products.lesson_fields.wechat_hint' | t }}</small>
    </div>

    <div class="field lesson-fields__wide">
      <textarea
        class="text-area field__input"
        id="LessonLevel-{{ uid }}"
        name="properties[学生水平描述]"
        form="{{ product_form_id }}"
        rows="3"
        placeholder="{{ 'products.lesson_fields.level_placeholder' | t }}"
      ></textarea>
      <label class="field__label" for="LessonLevel-{{ uid }}">{{ 'products.lesson_fields.level' | t }}</label>
    </div>
  </div>
</fieldset>
<script>
  // Buy buttons only render for signed-in members (or Public products). Without the
  // product form there is nothing to submit, so hide the fields too.
  //
  // The theme's product form is `novalidate`, so `required` alone does not stop Add to
  // cart. This capture-phase listener runs before product-form.js and blocks the
  // submit until the required fields are filled.
  (() => {
    const fields = document.currentScript.previousElementSibling;
    const formId = {{ product_form_id | json }};
    const init = () => {
      const form = document.getElementById(formId);
      fields.hidden = !form;
      if (!form) return;
      form.addEventListener('submit', (event) => {
        const invalid = [...fields.querySelectorAll('input, textarea')].filter((el) => !el.checkValidity());
        if (!invalid.length) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        fields.classList.add('is-checked');
        invalid[0].focus();
        invalid[0].reportValidity();
      }, true);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
