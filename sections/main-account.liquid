{{ 'customer.css' | asset_url | stylesheet_tag }}
{{ 'section-main-account.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif

  assign book_url = section.settings.book_link
  if book_url == blank
    assign book_url = root | append: '/collections/private-packages'
  endif
  assign team_url = section.settings.team_link
  if team_url == blank
    assign team_url = root | append: '/pages/our-team'
  endif
  assign contact_url = section.settings.contact_link
  if contact_url == blank
    assign contact_url = root | append: '/pages/contact-us'
  endif

  assign display_name = customer.first_name
  if display_name == blank
    assign display_name = customer.name
  endif

  assign visible_earlier = 3
-%}

<div class="acct section-{{ section.id }}-padding">
  <section class="acct-hero">
    <div class="page-width acct-hero__inner">
      <div>
        <h1 class="acct-hero__title">
          {%- if display_name != blank -%}
            {{ 'customer.account_page.welcome_html' | t: name: display_name }}
          {%- else -%}
            {{ 'customer.account_page.welcome_plain' | t }}
          {%- endif -%}
        </h1>
        <p class="acct-hero__email">{{ customer.email }}</p>
        {%- if customer.orders_count > 0 -%}
          <dl class="acct-hero__stats">
            <div>
              <dt>{{ 'customer.account_page.orders' | t }}</dt>
              <dd>{{ customer.orders_count }}</dd>
            </div>
            <div>
              <dt>{{ 'customer.account_page.last_order' | t }}</dt>
              <dd>{{ customer.orders.first.created_at | time_tag: format: 'date' }}</dd>
            </div>
          </dl>
        {%- endif -%}
      </div>
      <a class="acct-btn acct-btn--light" href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a>
    </div>
  </section>

  <div class="page-width">
    {% paginate customer.orders by 20 %}
      {%- liquid
        assign first_page = true
        if paginate.current_page > 1
          assign first_page = false
        endif
      -%}

      {%- if customer.orders.size > 0 -%}
        {%- if first_page -%}
          {%- assign order = customer.orders.first -%}
          {%- assign item = order.line_items.first -%}
          <article class="acct-feature">
            <a class="acct-feature__media" href="{{ order.customer_url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {{ item.image | image_url: width: 400 | image_tag: loading: 'eager', alt: '', widths: '200, 400' }}
              {%- endif -%}
            </a>
            <div class="acct-feature__body">
              <p class="acct-label">
                {{ 'customer.account_page.latest_order' | t }} · {{ order.name }} ·
                {{ order.created_at | time_tag: format: 'date' }}
              </p>
              <h2 class="acct-feature__title">
                {{ item.title }}
                {%- if item.quantity > 1 %} × {{ item.quantity }}{% endif -%}
                {%- if order.line_items.size > 1 %}
                  <span class="acct-more">
                    {%- assign extra_items = order.line_items.size | minus: 1 -%}
                    {{- 'customer.account_page.more_items' | t: count: extra_items -}}
                  </span>
                {%- endif -%}
              </h2>
              {% render 'account-order-status', order: order %}
              <div class="acct-feature__actions">
                <a
                  class="acct-btn"
                  href="{{ order.customer_url }}"
                  aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
                >
                  {{- 'customer.account_page.view_order' | t -}}
                </a>
                {%- if item.product and item.product.available -%}
                  <a class="acct-btn acct-btn--ghost" href="{{ item.product.url }}">
                    {{- 'customer.account_page.book_again' | t -}}
                  </a>
                {%- endif -%}
              </div>
            </div>
            <p class="acct-feature__total">{{ order.total_net_amount | money_with_currency }}</p>
          </article>
        {%- endif -%}

        {%- liquid
          assign list_count = customer.orders.size
          if first_page
            assign list_count = list_count | minus: 1
          endif
        -%}

        {%- if list_count > 0 -%}
          <section class="acct-section">
            <h2 class="acct-section__title">
              {%- if first_page -%}
                {{ 'customer.account_page.earlier_orders' | t }}
              {%- else -%}
                {{ 'customer.orders.title' | t }}
              {%- endif -%}
            </h2>
            <ul class="acct-orders" role="list" id="AcctOrders-{{ section.id }}">
              {%- for order in customer.orders -%}
                {%- if first_page and forloop.first -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  assign index = forloop.index
                  if first_page
                    assign index = index | minus: 1
                  endif
                  assign item = order.line_items.first
                -%}
                <li
                  class="acct-order{% if first_page and index > visible_earlier %} acct-order--extra{% endif %}"
                >
                  <a
                    class="acct-order__link"
                    href="{{ order.customer_url }}"
                    aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
                  >
                    <span class="acct-thumb">
                      {%- if item.image -%}
                        {{ item.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                      {%- endif -%}
                    </span>
                    <span class="acct-order__text">
                      <span class="acct-order__title">
                        {{- item.title -}}
                        {%- if item.quantity > 1 %} × {{ item.quantity }}{% endif -%}
                        {%- if order.line_items.size > 1 %}
                          <span class="acct-more">
                            {%- assign extra_items = order.line_items.size | minus: 1 -%}
                    {{- 'customer.account_page.more_items' | t: count: extra_items -}}
                          </span>
                        {%- endif -%}
                      </span>
                      <span class="acct-order__meta">
                        {{- order.name -}}
                        <span class="acct-order__date"> · {{ order.created_at | time_tag: format: 'date' }}</span>
                      </span>
                    </span>
                    {% render 'account-order-status', order: order %}
                    <span class="acct-order__total">{{ order.total_net_amount | money_with_currency }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>

            {%- if first_page and list_count > visible_earlier -%}
              <button
                type="button"
                class="acct-toggle"
                aria-expanded="false"
                aria-controls="AcctOrders-{{ section.id }}"
                data-acct-toggle
                data-more="{{ 'customer.account_page.show_all' | t: count: customer.orders_count | escape }}"
                data-less="{{ 'customer.account_page.show_less' | t | escape }}"
              >
                {{- 'customer.account_page.show_all' | t: count: customer.orders_count -}}
              </button>
            {%- endif -%}

            {%- if paginate.pages > 1 and paginate.parts.size > 0 -%}
              <nav
                class="acct-pagination{% if first_page %} acct-pagination--extra{% endif %}"
                role="navigation"
                aria-label="{{ 'general.pagination.label' | t }}"
              >
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">←</a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                      {{- part.title -}}
                    </a>
                  {%- elsif part.title == paginate.current_page -%}
                    <span aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span>{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">→</a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          </section>
        {%- endif -%}
      {%- else -%}
        <div class="acct-empty">
          <p>{{ 'customer.orders.none' | t }}</p>
          <a class="acct-btn" href="{{ book_url }}">{{ 'customer.account_page.book_lesson' | t }}</a>
        </div>
      {%- endif -%}
    {% endpaginate %}

    <div class="acct-two">
      <section class="acct-box">
        <h2 class="acct-section__title">{{ 'customer.account_page.default_address' | t }}</h2>
        {%- if customer.default_address -%}
          <div class="acct-address">{{ customer.default_address | format_address }}</div>
        {%- else -%}
          <p class="acct-muted">{{ 'customer.account_page.no_address' | t }}</p>
        {%- endif -%}
        <a class="acct-link" href="{{ routes.account_addresses_url }}">
          {{- 'customer.account_page.manage_addresses' | t }} ({{ customer.addresses_count }})
        </a>
      </section>

      <section class="acct-box acct-cta">
        <h2 class="acct-cta__title">{{ 'customer.account_page.cta_title' | t }}</h2>
        <div class="acct-cta__actions">
          <a class="acct-btn" href="{{ book_url }}">{{ 'customer.account_page.book_lesson' | t }}</a>
          <a class="acct-btn acct-btn--ghost" href="{{ team_url }}">{{ 'customer.account_page.see_team' | t }}</a>
        </div>
        <p class="acct-cta__ask">
          {{ 'customer.account_page.learn_more' | t }}
          <a href="{{ contact_url }}">{{ 'customer.account_page.contact_us' | t }} →</a>
        </p>
      </section>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-acct-toggle]').forEach(function (btn) {
    var list = document.getElementById(btn.getAttribute('aria-controls'));
    if (!list) return;
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', open);
      list.classList.toggle('is-open', open);
      var section = list.closest('.acct-section');
      if (section) section.classList.toggle('is-open', open);
      btn.textContent = open ? btn.dataset.less : btn.dataset.more;
    });
  });
</script>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "url",
      "id": "book_link",
      "label": "Book a lesson link"
    },
    {
      "type": "url",
      "id": "team_link",
      "label": "Instructor team link"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact us link"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
