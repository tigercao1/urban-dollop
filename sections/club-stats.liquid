{%- comment -%}
  Stat band — the cheapest club signal available.

  No photography, pure type. "340 会员 · 12 教练" is something a shop
  structurally cannot say, and it costs one section of markup. Deliberately
  quiet: it sits between two loud sections and supplies the contrast that makes
  them read as loud.
{%- endcomment -%}

{{ 'club.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign counts_instructors = false
  assign counts_season_cards = false
  for block in section.blocks
    if block.settings.source == 'instructors'
      assign counts_instructors = true
    endif
    if block.settings.source == 'season_cards'
      assign counts_season_cards = true
    endif
  endfor
-%}

{%- if counts_instructors -%}
  {%- assign instructor_count = 0 -%}
  {%- paginate shop.metaobjects.ssms_instructor.values by 250 -%}
    {%- capture ssms_handles -%}
      |{%- for entry in shop.metaobjects.ssms_instructor.values -%}
        {%- assign instructor_count = instructor_count | plus: 1 -%}
        {{- entry.system.handle -}}|
      {%- endfor -%}
    {%- endcapture -%}
  {%- endpaginate -%}
  {%- for entry in shop.metaobjects.our_team.values -%}
    {%- assign handle_key = '|' | append: entry.system.handle | append: '|' -%}
    {%- unless ssms_handles contains handle_key -%}
      {%- assign instructor_count = instructor_count | plus: 1 -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endif -%}

{%- if counts_season_cards -%}
  <script src="{{ 'club-stats.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="club-stats{% if section.blocks.size <= 2 %} club-stats--few{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="club-stats__heading">{{ section.settings.heading }}</p>
    {%- endif -%}

    <dl class="club-stats__grid" style="--stat-columns: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        {%- liquid
          case block.settings.source
            when 'instructors'
              assign stat_value = instructor_count
            when 'collection_products'
              assign stat_value = block.settings.collection.products_count
            when 'members'
              assign stat_value = metaobjects.site_stats['current'].member_count.value
            else
              assign stat_value = nil
          endcase
          if stat_value == blank
            assign stat_value = block.settings.value
          endif
        -%}
        <div class="club-stats__item" {{ block.shopify_attributes }}>
          <dt class="club-stats__value">
            <span class="club-stats__number" data-stat-source="{{ block.settings.source }}">
              {{- stat_value -}}
            </span>
            {%- if block.settings.suffix != blank -%}
              <span class="club-stats__suffix">{{ block.settings.suffix }}</span>
            {%- endif -%}
          </dt>
          <dd class="club-stats__label">{{ block.settings.label }}</dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
</div>

{% schema %}
{
  "name": "Club stats",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Numbers only — members, instructors, events, trips. Keep it to four or five."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Small heading above",
      "default": "本季"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "inverse"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Number source",
          "options": [
            { "value": "manual", "label": "Typed in below" },
            { "value": "instructors", "label": "Instructors on the roster" },
            { "value": "collection_products", "label": "Products in a collection" },
            { "value": "members", "label": "Member count (site stats)" },
            { "value": "season_cards", "label": "Cards in the season row" }
          ],
          "default": "manual"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Only used when the source is products in a collection."
        },
        {
          "type": "text",
          "id": "value",
          "label": "Number",
          "info": "Shown as typed when the source is manual, and as the fallback when a live source has no value.",
          "default": "340"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "会员"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Club stats",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
