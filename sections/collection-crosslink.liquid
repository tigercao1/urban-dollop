{%- comment -%}
  One-line cross-link under a collection's description (above the filters),
  e.g. 少儿团课 -> 小型私课: "想要一对一的专属指导？  查看小型私课 ->".
  Only the heading and button are shown; the small label and text settings are
  kept (with their translations) but not displayed in this compact layout.
  Each block is one card and names the collection it shows on ("Show on"),
  so one section in a shared template (collection.json) can hold the cards for
  several collections; only the blocks for the current collection render.
{%- endcomment -%}
{%- liquid
  assign has_card = false
  for block in section.blocks
    if block.settings.show_on != blank and block.settings.show_on.handle == collection.handle
      assign has_card = true
    endif
  endfor
-%}
{%- if has_card -%}
  {{ 'component-collection-crosslink.css' | asset_url | stylesheet_tag }}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
  <div class="page-width section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- if block.settings.show_on != blank and block.settings.show_on.handle == collection.handle -%}
        <p class="collection-crosslink" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <span class="collection-crosslink__heading">{{ block.settings.heading | escape }}</span>
          {%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
            <a class="collection-crosslink__link" href="{{ block.settings.button_link }}">
              {{- block.settings.button_label | escape -}}
              <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </a>
          {%- endif -%}
        </p>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection cross-link",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Cross-link card",
      "settings": [
        {
          "type": "collection",
          "id": "show_on",
          "label": "Show on collection"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small label (not shown in compact layout)",
          "default": "也可以看看"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text (not shown in compact layout)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection cross-link"
    }
  ]
}
{% endschema %}
